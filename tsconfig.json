{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "lib": ["ES2024", "DOM", "WebWorker"],
    "types": ["node", "vite/client"]
  },
  "include": ["ui/**/*", "feedback/**/*", "e2e.test.ts", "vite.config.ts"]
}
